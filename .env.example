# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=zBD Agent
# zBD Agent — copy sang `.env` rồi điền secret thật.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
APP_DEBUG=true
# Ký access + refresh token. Sinh bằng: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# ── Docker services (postgres / redis / minio) ───────────────────────────────
POSTGRES_USER=zbd
POSTGRES_PASSWORD=zbd_dev_password
POSTGRES_DB=zbd
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=zbd_minio
MINIO_ROOT_PASSWORD=zbd_minio_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Backend (chạy trên host qua uv) kết nối tới các container trên ───────────
DATABASE_URL=postgresql+asyncpg://zbd:zbd_dev_password@localhost:5432/zbd
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=zbd_minio
MINIO_SECRET_KEY=zbd_minio_dev_password
MINIO_SECURE=false

BACKEND_PORT=8000

# ── Xác thực ─────────────────────────────────────────────────────────────────
# Chỉ các domain này được cấp OTP (mã lỗi AUTH_DOMAIN).
ALLOWED_EMAIL_DOMAINS=vng.com.vn
OTP_TTL_SECONDS=300
OTP_RESEND_AFTER_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
ACCESS_TOKEN_TTL_MINUTES=360
REFRESH_TOKEN_TTL_DAYS=30

# ── Admin khởi tạo — import vào DB khi app khởi động ─────────────────────────
# Các email này được đảm bảo tồn tại trong bảng `users` với role ADMIN mỗi lần
# app start (idempotent, không tạo trùng). Chỉ dùng để mồi admin đầu tiên —
# nguồn sự thật vẫn là DB.
#   - Xoá email khỏi đây KHÔNG hạ quyền ai.
#   - Quản lý về sau qua /admin/users hoặc:
#       uv run python -m app.users grant-admin <email>
#       uv run python -m app.users revoke-admin <email>
#       uv run python -m app.users list
BOOTSTRAP_ADMIN_EMAILS=khanhpp@vng.com.vn,lanlt2@vng.com.vn,huonglx@vng.com.vn,zaloadmin@vng.com.vn

# ── Tài khoản vào thẳng, không cần OTP ───────────────────────────────────────
# Email trong danh sách này đăng nhập không cần mã OTP. Đây là đường bỏ qua xác
# thực nên: tự vô hiệu hoá khi APP_ENV=production, ghi audit `auth.bypass_login`
# mỗi lần dùng, và log ở mức warning. Vẫn là user thường trong DB nên vẫn chịu
# phân quyền và vẫn bị chặn nếu status=locked.
OTP_BYPASS_EMAILS=zaloadmin@vng.com.vn

# Email điền sẵn ở màn đăng nhập (để trống = không điền sẵn).
# Admin có thấy resource của người khác không. false = isolate hoàn toàn: khách hàng,
# skill, KB, template chỉ hiện với người sở hữu, người được share, hoặc khi đã publish
# thành Shared. Các mục Quản trị (user, audit, policy) không phụ thuộc cờ này.
ADMIN_SEES_ALL_RESOURCES=false
LOGIN_DEFAULT_EMAIL=
# Các email LUÔN chạy lại luồng lần đầu (onboarding + hướng dẫn) mỗi lần đăng nhập,
# kể cả khi đã hoàn tất — dùng để xem/demo luồng đó. Để trống = tắt.
ALWAYS_ONBOARDING_EMAILS=zaloadmin@vng.com.vn
# Bắt buộc bật thêm cờ này nếu thật sự muốn bypass hoạt động ở production.
ALLOW_OTP_BYPASS_IN_PRODUCTION=false

# ── Resend — OTP, mời thành viên, thông báo chia sẻ/duyệt ────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=zBD Agent <no-reply@yourdomain.vn>
RESEND_REPLY_TO=
# true = in email (kèm mã OTP) ra log thay vì gửi thật.
EMAIL_DRY_RUN=true

# ── VNG Cloud MaaS (AI Platform) ─────────────────────────────────────────────
# MaaS = GreenNode Self-host (hạ tầng AI của VNG) — không phải API công khai của OpenAI/Google.
# Cụm self-host: tên model phải khớp danh mục cụm đang chạy; pool một model có
# thể hết worker (503 no_available_workers) -> dùng MAAS_FALLBACK_MODELS bên dưới.
AI_PLATFORM_API_KEY=
MAAS_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
# Suy luận: Deep Research, viết proposal, khớp sản phẩm, chat trong editor.
MAAS_REASONING_MODEL=z-ai/glm-5.2
# Thị giác: PDF scan, ảnh slide, logo.
MAAS_VISION_MODEL=google/gemma-4-31b-it
# Model dự phòng khi pool của MAAS_REASONING_MODEL sập (503 no_available_workers)
# hoặc gateway lỗi tạm thời. Thử lần lượt từ trái sang phải.
MAAS_FALLBACK_MODELS=gemini/gemini-3.1-flash-lite,qwen/qwen3.7-plus,gemini/gemini-3-flash-preview
# Số giây chờ giữa các lần thử
MAAS_RETRY_DELAYS=2,8

# ── Nhóm ngành đang tập trung ────────────────────────────────────────────────
# ƯU TIÊN MỀM: khách ngoài ngành vẫn research/matching bình thường. Focus chỉ
# thêm bối cảnh ngành vào prompt, cộng điểm nguồn, và chiếm 3/6 slot truy vấn
# site:. Để trống FOCUS_INDUSTRY là tắt hẳn, mọi ngành về lại trung tính.
FOCUS_INDUSTRY=BFSI
FOCUS_PREFERRED_DOMAINS=sbv.gov.vn,vnba.org.vn,thitruongtaichinhtiente.vn,tinnhanhchungkhoan.vn,iav.vn,fiingroup.vn,napas.com.vn
FOCUS_PRESS_SLOTS=3

#
# max_tokens / temperature / top_p / timeout KHÔNG đặt ở đây nữa.
# Chúng nằm ở harness layer (app/integrations/harness.py) với profile riêng cho
# từng tác vụ, vì mỗi tác vụ cần tham số khác nhau: research.extract dùng
# temp 0.25 + 8000 token, editor.chat dùng temp 0.6, vision.ocr dùng temp 0.1 +
# timeout 300s. Xem tham số đang áp: GET /api/v1/admin/ai-profiles
# Màn Quản trị (AiConfig trong DB) chỉ đè `model` và làm trần `max_tokens`.

# ── Web search cho Deep Research ─────────────────────────────────────────────
# Thứ tự provider; client failover từ trái sang phải.
SEARCH_PROVIDERS=langsearch,tavily
LANGSEARCH_API_KEY=
LANGSEARCH_BASE_URL=https://api.langsearch.com/v1
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# ── Phạm vi thị trường của Deep Research ─────────────────────────────────────
RESEARCH_MARKET=VN
RESEARCH_LOCALE=vi

# ── Upload (mã lỗi FILE_TYPE / FILE_SIZE) ────────────────────────────────────
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,pptx

# ── Frontend ─────────────────────────────────────────────────────────────────
# Backend tự serve src/frontend ở http://localhost:8000/ nên prototype cùng
# origin với API, không cần CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Dev: mã OTP cố định, bỏ qua gửi email. Để trống để bật lại OTP ngẫu nhiên qua email.
OTP_DEV_CODE=123456
ALLOW_OTP_DEV_CODE_IN_PRODUCTION=false
APP_BASE_URL=http://localhost:8000
EMAIL_SANDBOX_TO=

